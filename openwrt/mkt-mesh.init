#!/bin/sh /etc/rc.common
# OpenWrt procd service for MikroTik Mesh Daemon

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/mkt-cli

start_service() {
    procd_open_instance
    procd_set_param command "$PROG" daemon --control-bind 127.0.0.1:20560 --relay-bind 0.0.0.0:443
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall -q mkt-cli
}
