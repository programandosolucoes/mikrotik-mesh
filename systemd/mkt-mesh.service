[Unit]
Description=MikroTik Mesh VPN, EoIP & MAC-Telnet 24/7 Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/bin
ExecStart=/usr/local/bin/mkt-cli daemon --control-bind 127.0.0.1:20560 --relay-bind 0.0.0.0:443
Restart=always
RestartSec=5
LimitNOFILE=65536

# Security & Capabilities (Principle of least privilege)
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
